# ============================================================================
#  Copy this file to .env and fill in what you need.
#  .env is never committed (it is in .gitignore).
#
#  The system runs fully without any of these. They are all optional.
# ============================================================================

# ---- Telegram alerts (optional, free) ----
# 1) Open Telegram and search for  @BotFather
# 2) Send  /newbot  and follow the prompts to get the token
# 3) Send your bot a message, then open:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    and copy the number from  "chat":{"id": ... }
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- FRED (entirely optional) ----
# Macro series are read through the public CSV endpoint, which needs no key.
# A free key from fred.stlouisfed.org only raises the rate limits.
FRED_API_KEY=

# ---- Database (optional) ----
# Defaults to a SQLite file under data/. Change this only for PostgreSQL.
# ANALYST_DATABASE_URL=postgresql+psycopg://user:pass@localhost/analyst
