# ============================================================================
#  Copy this file to .env and fill in what you need.
#  .env is never committed (it is in .gitignore).
#
#  The system runs fully without any of these. They are all optional.
# ============================================================================

# ---- Telegram alerts (optional, free) ----
# 1) Open Telegram and search for  @BotFather
# 2) Send  /newbot  and follow the prompts to get the token
# 3) Send your bot a message, then open:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    and copy the number from  "chat":{"id": ... }
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- AI analyst (optional) ----
# Turns on a plain-language read of each stored analysis (market bias, main
# reason, bull/bear scenarios, invalidation, risk warnings) generated on
# demand by Claude. Without a key, the system behaves exactly as before --
# deterministic reports only, no AI, no extra cost.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# ANALYST_AI_MODEL=claude-haiku-4-5-20251001

# ---- FRED (entirely optional) ----
# Macro series are read through the public CSV endpoint, which needs no key.
# A free key from fred.stlouisfed.org only raises the rate limits.
FRED_API_KEY=

# ---- Database (optional) ----
# Defaults to a SQLite file under data/. Change this only for PostgreSQL.
# ANALYST_DATABASE_URL=postgresql+psycopg://user:pass@localhost/analyst

# ---- Dashboard login (strongly recommended once this is deployed online) ----
# Set both to turn on HTTP Basic Auth for the dashboard and API. Left blank,
# a local run stays open with no login, exactly as before.
DASHBOARD_USER=
DASHBOARD_PASSWORD=
