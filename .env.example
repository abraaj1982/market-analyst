# ============================================================================
#  انسخ هذا الملف باسم .env ثم املأ القيم.
#  ملف .env لا يُرفع إلى GitHub أبداً (محمي في .gitignore).
#  ⚠️ النظام يعمل بالكامل بدون أي من هذه المفاتيح — كلها اختيارية.
# ============================================================================

# ---- تنبيهات تيليجرام (اختياري، مجاني) ----
# 1) افتح تيليجرام وابحث عن  @BotFather
# 2) أرسل  /newbot  واتبع الخطوات، ستحصل على التوكن
# 3) أرسل رسالة لبوتك، ثم افتح:
#    https://api.telegram.org/bot<التوكن>/getUpdates
#    وانسخ الرقم من  "chat":{"id": ... }
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- FRED (اختياري تماماً) ----
# النظام يقرأ بيانات الفيدرالي عبر رابط CSV العام بدون مفتاح.
# المفتاح المجاني من fred.stlouisfed.org يرفع حدود الاستخدام فقط.
FRED_API_KEY=

# ---- قاعدة البيانات (اختياري) ----
# الافتراضي: ملف SQLite داخل مجلد data/. غيّره فقط لو أردت PostgreSQL.
# ANALYST_DATABASE_URL=postgresql+psycopg://user:pass@localhost/analyst
